# ==============================================================================
# FreightERP — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure production values before deployment.

# Node Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Self-Hosted Replica Set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/freighterp?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_key_min_32_chars
JWT_EXPIRES_IN=7d
PORTAL_JWT_SECRET=replace_this_with_a_separate_portal_secret_key_min_32_chars
PORTAL_JWT_EXPIRES_IN=7d

# Outbound SMTP Mail Configuration (Transactional Emails & Dispatch)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
SMTP_FROM="FreightERP Operations" <dispatch@freighterp.com>
ENABLE_EMAIL_DISPATCH=true

# Document Storage Abstraction (local OR s3)
STORAGE_PROVIDER=local
UPLOAD_PATH=uploads

# AWS S3 / Cloudflare R2 Document Storage Configuration (When STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=freighterp-secure-documents
AWS_S3_ENDPOINT=
